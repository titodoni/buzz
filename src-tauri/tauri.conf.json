{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buzz",
  "version": "0.1.0",
  "identifier": "app.buzz.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Buzz",
        "url": "/",
        "width": 260,
        "height": 560,
        "minWidth": 220,
        "minHeight": 400,
        "resizable": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Buzz",
    "copyright": "© 2026 the Buzz authors. Not affiliated with Yahoo.",
    "category": "SocialNetworking",
    "shortDescription": "Chat with your friends, classic messenger style",
    "longDescription": "Buzz brings back the classic desktop messenger: a buddy list that shows who is online, one window per chat, status messages, emoticons, and the Buzz! nudge."
  }
}
