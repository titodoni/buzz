{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buzz",
  "version": "0.1.1",
  "identifier": "app.buzz.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Buzz",
        "url": "/",
        "width": 260,
        "height": 560,
        "minWidth": 220,
        "minHeight": 400,
        "resizable": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://mkeozqwudranxrdferai.supabase.co",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://mkeozqwudranxrdferai.supabase.co wss://mkeozqwudranxrdferai.supabase.co",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://mkeozqwudranxrdferai.supabase.co",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:3000 ws://localhost:3000 https://mkeozqwudranxrdferai.supabase.co wss://mkeozqwudranxrdferai.supabase.co",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Buzz",
    "copyright": "\u00a9 2026 the Buzz authors. Not affiliated with Yahoo.",
    "category": "SocialNetworking",
    "shortDescription": "Chat with your friends, classic messenger style",
    "longDescription": "Buzz brings back the classic desktop messenger: a buddy list that shows who is online, one window per chat, status messages, emoticons, and the Buzz! nudge."
  }
}
